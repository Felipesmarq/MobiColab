# Copie para .env e ajuste. O .env nunca vai para o repositório.

DEBUG=True
SECRET_KEY=troque-esta-chave-fora-do-ambiente-local
ALLOWED_HOSTS=localhost,127.0.0.1

# Fora do Docker. Dentro do Compose, o serviço web usa o host "db" automaticamente.
DATABASE_URL=postgres://mobicolab:mobicolab@localhost:5432/mobicolab

# Usadas pelo serviço db do Compose
POSTGRES_DB=mobicolab
POSTGRES_USER=mobicolab
POSTGRES_PASSWORD=mobicolab

# Parâmetros das regras de negócio (spec, seções 5 e 12). Descomente para calibrar.
# RELATO_MEIA_VIDA_MIN=15
# RELATO_PESO_CONFIRMACAO=0.5
# RELATO_PESO_CONTESTACAO=0.5
# RELATO_VALIDADE_MIN=45
# RELATO_INTERVALO_MIN=10
# PESO_MINIMO=0.5
# LIMIAR_CONTESTACAO=3
